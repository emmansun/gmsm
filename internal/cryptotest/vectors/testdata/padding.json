  "testGroups": [
    {
      "type": "PKCS7",
      "comment": "PKCS#7: every padding byte equals the padding length, and a full block is always added.",
      "tests": [
        {
          "tcId": 1,
          "comment": "whole block of padding",
          "flags": [
            "BlockSize16"
          ],
          "result": "valid",
          "input": "10101010101010101010101010101010"
        },
        {
          "tcId": 2,
          "comment": "one byte and fifteen pad bytes",
          "flags": [
            "BlockSize16"
          ],
          "expected": "01",
          "result": "valid",
          "input": "010f0f0f0f0f0f0f0f0f0f0f0f0f0f0f"
        },
        {
          "tcId": 3,
          "comment": "fifteen bytes and one pad byte",
          "flags": [
            "BlockSize16"
          ],
          "expected": "000102030405060708090a0b0c0d0e",
          "result": "valid",
          "input": "000102030405060708090a0b0c0d0e01"
        },
        {
          "tcId": 4,
          "comment": "aligned plaintext gets a full block",
          "flags": [
            "BlockSize16"
          ],
          "expected": "000102030405060708090a0b0c0d0e0f",
          "result": "valid",
          "input": "000102030405060708090a0b0c0d0e0f10101010101010101010101010101010"
        },
        {
          "tcId": 5,
          "comment": "empty input",
          "flags": [
            "BlockSize16"
          ],
          "result": "invalid"
        },
        {
          "tcId": 6,
          "comment": "length not a multiple of the block size",
          "flags": [
            "BlockSize16"
          ],
          "result": "invalid",
          "input": "000102030405060708090a0b0c0d0e0f00"
        },
        {
          "tcId": 7,
          "comment": "zero pad byte",
          "flags": [
            "BlockSize16"
          ],
          "result": "invalid",
          "input": "00000000000000000000000000000000"
