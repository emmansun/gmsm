{
  "schema": "gmsm-semantics-vectors/v1",
  "algorithm": "sm4",
  "generator": "go test ./internal/cryptotest/sm4vectors -run TestVectorsUpToDate -update",
  "testGroups": [
    {
      "type": "GCM",
      "comment": "SM4-GCM. Ciphertext is C||T unless a truncated tag is configured. The standard cases are checked against GB/T 36624-2018 and GB/T 15852.3-2019; the generic Go implementation, not the SM4 kernel, produces the derived nonce and tag sizes.",
      "tests": [
        {
          "tcId": 1,
          "comment": "GB/T 36624-2018 C.5: empty plaintext, empty AAD",
          "ciphertext": "232f0cfe308b49ea6fc88229b5dc858d",
          "result": "valid",
          "key": "00000000000000000000000000000000",
          "nonce": "000000000000000000000000"
        },
        {
          "tcId": 2,
          "comment": "GB/T 36624-2018 C.5: one zero block",
          "ciphertext": "7de2aa7f1110188218063be1bfeb6d89b851b5f39493752be508f1bb4482c557",
          "result": "valid",
          "key": "00000000000000000000000000000000",
          "nonce": "000000000000000000000000",
          "plaintext": "00000000000000000000000000000000"
        },
        {
          "tcId": 3,
          "comment": "GB/T 15852.3-2019 A.4 GMAC: 16-byte AAD",
          "ciphertext": "9d632570f93064264a20918e3081b4cd",
          "result": "valid",
          "key": "feffe9928665731c6d6a8f9467308308",
          "nonce": "cafebabefacedbaddecaf888",
          "aad": "feedfacedeadbeeffeedfacedeadbeef"
        },
        {
          "tcId": 4,
          "comment": "GB/T 15852.3-2019 A.4 GMAC: 40-byte AAD",
          "ciphertext": "1eeaeb669e96bd059bd9929123030e78",
          "result": "valid",
          "key": "feffe9928665731c6d6a8f9467308308",
          "nonce": "cafebabefacedbaddecaf888",
          "aad": "feedfacedeadbeeffeedfacedeadbeefabaddad242831ec2217774244b7221b7"
        },
        {
          "tcId": 5,
          "comment": "64-bit nonce",
          "ciphertext": "187269dfeb929a507ae17aad126505342af6ed692baddc918ce2851b29b19761",
          "result": "valid",
          "key": "00000000000000000000000000000000",
          "nonce": "0102030405060708",
          "aad": "a0a1a2",
          "plaintext": "00112233445566778899aabbccddeeff",
          "nonceSize": 8
        },
        {
          "tcId": 6,
          "comment": "96-bit tag",
          "ciphertext": "3d311fe77d90f7745be1c94de038898e5971fef28291e54c796d05d5",
          "result": "valid",
          "key": "feffe9928665731c6d6a8f9467308308",
          "nonce": "cafebabefacedbaddecaf888",
          "aad": "feedfacedeadbeeffeedfacedeadbeef",
          "plaintext": "00112233445566778899aabbccddeeff",
          "tagSize": 12
        },
        {
          "tcId": 7,
          "comment": "tag bit flipped",
          "ciphertext": "232f0cfe308b49ea6fc88229b5dc858c",
          "result": "invalid",
          "key": "00000000000000000000000000000000",
          "nonce": "000000000000000000000000"
        },
        {
          "tcId": 8,
          "comment": "tag bit flipped on a one-block message",
          "ciphertext": "7de2aa7f1110188218063be1bfeb6d89b851b5f39493752be508f1bb4482c556",
          "result": "invalid",
          "key": "00000000000000000000000000000000",
          "nonce": "000000000000000000000000",
          "plaintext": "00000000000000000000000000000000"
        },
        {
          "tcId": 9,
          "comment": "shorter than the tag",
          "ciphertext": "232f0cfe308b49ea6fc88229",
          "result": "invalid",
          "key": "00000000000000000000000000000000",
          "nonce": "000000000000000000000000"
        },
        {
          "tcId": 10,
          "comment": "truncated by one byte",
          "ciphertext": "7de2aa7f1110188218063be1bfeb6d89b851b5f39493752be508f1bb4482c5",
          "result": "invalid",
          "key": "00000000000000000000000000000000",
          "nonce": "000000000000000000000000",
          "plaintext": "00000000000000000000000000000000"
        },
        {
          "tcId": 11,
          "comment": "wrong AAD",
          "ciphertext": "9d632570f93064264a20918e3081b4cd",
          "result": "invalid",
          "key": "feffe9928665731c6d6a8f9467308308",
          "nonce": "cafebabefacedbaddecaf888",
          "aad": "feedfacedeadbeeffeedfacedeadbeee"
        },
        {
          "tcId": 12,
          "comment": "wrong nonce",
          "ciphertext": "232f0cfe308b49ea6fc88229b5dc858d",
          "result": "invalid",
          "key": "00000000000000000000000000000000",
          "nonce": "000000000000000000000001"
        },
        {
          "tcId": 13,
          "comment": "tag size below the minimum",
          "result": "invalid",
          "key": "00000000000000000000000000000000",
          "nonce": "000000000000000000000000",
          "tagSize": 8
        },
        {
          "tcId": 14,
          "comment": "tag size above the maximum",
          "result": "invalid",
          "key": "00000000000000000000000000000000",
          "nonce": "000000000000000000000000",
          "tagSize": 17
        }
      ]
