    {
      "type": "CCM",
      "comment": "SM4-CCM as specified by RFC 3610. The RFC 8998 A.2 case validates the independent CBC-MAC/CTR implementation used to derive the 7- and 13-byte nonce and 32-bit tag cases.",
      "tests": [
        {
          "tcId": 1,
          "comment": "RFC 8998 A.2",
          "ciphertext": "48af93501fa62adbcd414cce6034d895dda1bf8f132f042098661572e7483094fd12e518ce062c98acee28d95df4416bed31a2f04476c18bb40c84a74b97dc5b16842d4fa186f56ab33256971fa110f4",
          "result": "valid",
          "key": "0123456789abcdeffedcba9876543210",
          "nonce": "00001234567800000000abcd",
          "aad": "feedfacedeadbeeffeedfacedeadbeefabaddad2",
          "plaintext": "aaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbccccccccccccccccddddddddddddddddeeeeeeeeeeeeeeeeffffffffffffffffeeeeeeeeeeeeeeeeaaaaaaaaaaaaaaaa"
        },
        {
          "tcId": 2,
          "comment": "empty plaintext with AAD",
          "ciphertext": "315494f3b26eec939d6e161bd71c361d",
          "result": "valid",
          "key": "0123456789abcdeffedcba9876543210",
          "nonce": "00001234567800000000abcd",
          "aad": "feedfacedeadbeeffeedfacedeadbeef"
        },
        {
          "tcId": 3,
          "comment": "7-byte nonce",
          "ciphertext": "f460ecf76c0bf7ecc6eccb6b1f7aa3798ba2107c88f22176",
          "result": "valid",
          "key": "0123456789abcdeffedcba9876543210",
          "nonce": "00010203040506",
          "plaintext": "0011223344556677",
          "nonceSize": 7
        },
        {
