    {
      "type": "GCMSIV",
      "comment": "SM4-GCM-SIV. The valid ciphertexts are the committed SM4-SIV KATs; every invalid case is a single-point mutation of one of them, and the tag check must fail.",
      "tests": [
        {
          "tcId": 1,
          "comment": "empty plaintext",
          "ciphertext": "1a8a0d12690856bd81e73d4b49a484a6",
          "result": "valid",
          "key": "01000000000000000000000000000000",
          "nonce": "030000000000000000000000"
        },
        {
          "tcId": 2,
          "comment": "AAD and 8-byte plaintext",
          "ciphertext": "25a3d08f8c1ab23e168ae39d5edc751b5939a21554bbe86f",
          "result": "valid",
          "key": "01000000000000000000000000000000",
          "nonce": "030000000000000000000000",
          "aad": "01",
          "plaintext": "0200000000000000"
        },
        {
          "tcId": 3,
          "comment": "tag bit flipped",
          "ciphertext": "1a8a0d12690856bd81e73d4b49a484a7",
          "result": "invalid",
          "key": "01000000000000000000000000000000",
          "nonce": "030000000000000000000000"
        },
        {
          "tcId": 4,
          "comment": "truncated by one byte",
          "ciphertext": "25a3d08f8c1ab23e168ae39d5edc751b5939a21554bbe8",
          "result": "invalid",
          "key": "01000000000000000000000000000000",
          "nonce": "030000000000000000000000",
          "aad": "01",
          "plaintext": "0200000000000000"
        },
        {
          "tcId": 5,
